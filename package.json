{
  "name": "webmcp-bridge-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for bridging local MCP clients to browser WebMCP through Playwright, adapters, and native example apps.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/holon-run/webmcp-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-run/webmcp-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/holon-run/webmcp-bridge/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "playwright",
    "browser-tools",
    "browser-automation",
    "ai-agent"
  ],
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "pnpm -r --filter \"@webmcp-bridge/*\" run build && pnpm -r --filter \"@webmcp-bridge/example-*\" run build",
    "typecheck": "pnpm -r --filter \"@webmcp-bridge/*\" run typecheck && pnpm -r --filter \"@webmcp-bridge/example-*\" run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "docs:dev": "npx -y mdorigin dev --root docs/site",
    "docs:build:index": "npx -y mdorigin build index --root docs/site",
    "docs:build:cloudflare": "npx -y mdorigin build cloudflare --root docs/site",
    "docs:build": "pnpm docs:build:index && pnpm docs:build:cloudflare"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.62.0"
  }
}
