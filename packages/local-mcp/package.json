{
  "name": "@webmcp-bridge/local-mcp",
  "version": "0.5.3",
  "type": "module",
  "description": "Local stdio MCP server that bridges local agents to browser WebMCP through Playwright.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "webmcp-local-mcp": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/holon-run/webmcp-bridge/tree/main/packages/local-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-run/webmcp-bridge.git",
    "directory": "packages/local-mcp"
  },
  "bugs": {
    "url": "https://github.com/holon-run/webmcp-bridge/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "playwright",
    "stdio",
    "browser",
    "ai-agent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@webmcp-bridge/adapter-fixture": "workspace:*",
    "@webmcp-bridge/adapter-google": "workspace:*",
    "@webmcp-bridge/adapter-weibo": "workspace:*",
    "@webmcp-bridge/adapter-x": "workspace:*",
    "@webmcp-bridge/core": "workspace:*",
    "@webmcp-bridge/playwright": "workspace:*",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "license": "MIT"
}
